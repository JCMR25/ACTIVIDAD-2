#include <iostream>
#include <vector>

using namespace std;

class Carrito {
private:
    vector<double> precios;

public:
    void agregarPrecio(double precio) {
        precios.push_back(precio);
    }

    double calcularTotal() {
        double total = 0;
        for (double precio : precios) {
            total = total + precio;
        }
        return total;
    }
};

int main() {
    Carrito miCarrito;

    miCarrito.agregarPrecio(15.99);
    miCarrito.agregarPrecio(5.50);
    miCarrito.agregarPrecio(42.00);

    double totalFinal = miCarrito.calcularTotal();
    cout << "El total del carrito es: $" << totalFinal << endl;

    return 0;
}
